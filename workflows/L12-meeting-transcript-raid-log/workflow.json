{
  "name": "L12 · Meeting transcript → RAID log (Structured Output)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Project Meeting Transcript — RAID Analysis",
        "formDescription": "Paste a raw transcript from a project status, steering committee, sprint review, or governance call. The transcript will be analysed for Risks, Assumptions, Issues and Dependencies (RAID).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Meeting Title",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting Date",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Project Status Meeting"
                  },
                  {
                    "option": "Steering Committee Meeting"
                  },
                  {
                    "option": "Sprint Review"
                  },
                  {
                    "option": "Project Governance Call"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Transcript",
              "fieldType": "textarea",
              "placeholder": "Paste the full meeting transcript here...",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "a2453393-bacc-4d3e-a481-eb2378b01fe0",
      "name": "Submit Meeting Transcript",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyse the following project meeting transcript and identify every Risk, Assumption, Issue and Dependency (RAID).\n\nMeeting Title: {{ $json[\"Meeting Title\"] }}\nMeeting Type: {{ $json[\"Meeting Type\"] }}\nMeeting Date: {{ $json[\"Meeting Date\"] }}\n\nTranscript:\n{{ $json[\"Transcript\"] }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an experienced project-management analyst. Read the meeting transcript and extract a flat list of RAID items. For each item set \"category\" to exactly one of: \"Risk\", \"Assumption\", \"Issue\", \"Dependency\". Provide a concise \"description\", the responsible \"owner\" (use \"Unassigned\" if none is stated), the \"impact\", and a \"mitigation\" or next step (\"N/A\" if none). Only include items genuinely supported by the transcript. If a category has no items, simply omit them. Return the result using the required structured format."
            }
          ]
        },
        "batching": {}
      },
      "id": "4839d073-dc55-4064-823c-8ca35256c172",
      "name": "Extract RAID",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "5f2ec997-e260-4cf9-9c1f-6c250abca2e5",
      "name": "RAID Analysis Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        240,
        336
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"items\": [\n    {\n      \"category\": \"Risk\",\n      \"description\": \"Third-party vendor may miss the integration deadline.\",\n      \"owner\": \"Jane Doe\",\n      \"impact\": \"Could delay go-live by two weeks.\",\n      \"mitigation\": \"Escalate to vendor account manager and prepare fallback.\"\n    },\n    {\n      \"category\": \"Dependency\",\n      \"description\": \"Release depends on the security team completing the pen test.\",\n      \"owner\": \"Security Team\",\n      \"impact\": \"Blocks production deployment until resolved.\",\n      \"mitigation\": \"Book pen-test slot for next sprint.\"\n    }\n  ]\n}"
      },
      "id": "82f3bf05-950e-478f-9a7a-fea669272c31",
      "name": "RAID Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
