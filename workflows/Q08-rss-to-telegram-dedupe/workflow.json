{
  "name": "Q08 · Auto-post new articles to a Telegram channel (dedupe across runs)",
  "nodes": [
    {
      "parameters": {
        "content": "## 📣 Q08 · Channel autopilot\nEvery 30 min: reads a feed, keeps the last few days, and uses **Remove Duplicates → seen in previous executions** so each link is posted exactly once, ever.",
        "width": 460,
        "height": 300,
        "color": 7
      },
      "id": "8d70cc7e-99e7-5bda-b84b-9faf270cce7d",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "265cf641-615e-595b-b605-01cf6341f80b",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "feed_url",
              "value": "https://blog.n8n.io/rss/",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "channel",
              "value": "@your_channel_name",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "max_age_days",
              "value": 3,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "21990595-8d3d-54cc-be78-f99ee39db440",
      "name": "⚙️ Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.feed_url }}",
        "options": {}
      },
      "id": "ab789d0b-60fc-5931-9b99-b36ab02ccf70",
      "name": "Read Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.isoDate }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              },
              "rightValue": "={{ $now.minus({ days: $('⚙️ Config').first().json.max_age_days }).toISO() }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6e9273e1-5cf5-587c-870f-ca5f316ac716",
      "name": "Recent Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "isoDate"
            }
          ]
        },
        "options": {}
      },
      "id": "24d5eacc-e541-5211-b3b8-7c906a32814c",
      "name": "Oldest First",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "content": "⚠️ **Nothing posted?** A link is remembered the moment it passes this node, so a 2nd run posts nothing (that's the point).\nTo re-test: change `historySize` or recreate the node.\nNo `Limit` after this node on purpose: anything cut after dedupe would be marked seen and never posted.",
        "width": 320,
        "height": 190,
        "color": 4
      },
      "id": "448d7ca5-8fc3-5d5d-8107-94fa061a3406",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.link }}",
        "options": {
          "historySize": 5000
        }
      },
      "id": "9d1baf6d-75ff-5539-a838-b3a05d8d9a57",
      "name": "Only New Links",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('⚙️ Config').first().json.channel }}",
        "text": "=📰 <b>{{ $json.title }}</b>\n{{ ($json.contentSnippet || '').slice(0, 200) }}…\n{{ $json.link }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "6dcb8d34-e24a-5284-9812-097332aeb697",
      "name": "Post to Channel",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "⚙️ Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "⚙️ Config": {
      "main": [
        [
          {
            "node": "Read Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Feed": {
      "main": [
        [
          {
            "node": "Recent Only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recent Only": {
      "main": [
        [
          {
            "node": "Oldest First",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Oldest First": {
      "main": [
        [
          {
            "node": "Only New Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only New Links": {
      "main": [
        [
          {
            "node": "Post to Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [],
  "pinData": {}
}