{
  "name": "P05 · Bulk AI enrichment of 1,000s of rows (batches, rate limits, checkpoints, resume)",
  "nodes": [
    {
      "parameters": {
        "content": "## 🏗️ P05 · Process big lists safely\nReads only `status = pending` rows → **Loop Over Items** in batches of 10 → Gemini classifies each company → writes back `status = done` (or `error`) → waits 2 s → next batch.\nStop it any time; the next run **resumes** where it left off.",
        "width": 580,
        "height": 300,
        "color": 7
      },
      "id": "f226fe49-8494-533d-92f8-3c0a5e37d1af",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {},
      "id": "cd41a1a6-2d68-576e-b088-c76b6c3fc4ba",
      "name": "Run Manually or Nightly",
