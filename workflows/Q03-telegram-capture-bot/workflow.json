  "nodes": [
    {
      "parameters": {
        "content": "## 💬 Q03 · Your pocket inbox\nSend the bot:\n`/todo call CA about GST`\n`/exp 450 food lunch`\n`/note idea: weekly retro bot`\nIt files each into Google Sheets and replies ✅.",
        "width": 420,
