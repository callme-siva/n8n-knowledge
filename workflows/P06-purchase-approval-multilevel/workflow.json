{
  "name": "P06 · Purchase request with multi-level approval, timeouts and audit trail",
  "nodes": [
    {
      "parameters": {
        "content": "## ✅ P06 · Approvals without chasing people\nForm → request ID → **manager** approves (3-day timeout) → above ₹1,00,000 also **finance** approves → requester notified at every step → every decision logged in an audit sheet.",
        "width": 560,
        "height": 300,
        "color": 7
      },
      "id": "5bd40dc7-207d-54e2-8a06-e049f6b7db60",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "formTitle": "Purchase request",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Item / service",
              "requiredField": true
            },
            {
              "fieldLabel": "Amount (INR)",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Cost centre",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Engineering"
                  },
                  {
                    "option": "Sales"
                  },
                  {
                    "option": "Marketing"
                  },
                  {
                    "option": "Operations"
                  },
                  {
                    "option": "HR"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Justification",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "077c11f1-7be6-578c-9e38-d1575fd8a082",
      "name": "Purchase Request Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "finance_email",
              "value": "you@example.com",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "finance_threshold",
              "value": 100000,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "2798d931-1f9b-580c-a831-cb1171539a3a",
      "name": "⚙️ Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "content": "🔒 **Who approves is looked up, never typed.** The requester's manager comes from the `Team` sheet (`email` → `manager_email`), so nobody can route a request to themselves.\nNot in the sheet, or listed as their own manager? The request is refused.",
        "width": 320,
        "height": 170,
        "color": 4
      },
      "id": "e99aa759-b7a0-5f51-85c4-e8a0241f1bcb",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        200
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Team"
        },
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $('Purchase Request Form').item.json['Your email'].trim().toLowerCase() }}"
            }
          ]
        }
      },
      "id": "6b036385-ed7a-5015-9df1-e74420933bd4",
      "name": "Lookup Manager",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ($json.manager_email || '').trim() }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ ($json.manager_email || '').trim().toLowerCase() }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "={{ $('Purchase Request Form').item.json['Your email'].trim().toLowerCase() }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a860856-e92a-59df-9a6f-998100e786e2",
      "name": "Manager OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Purchase Request Form').item.json['Your email'] }}",
        "subject": "Purchase request not submitted",
        "emailType": "html",
        "message": "=<p>We couldn't find a manager for <b>{{ $('Purchase Request Form').item.json['Your email'] }}</b> in the Team sheet, so this request for {{ $('Purchase Request Form').item.json['Item / service'] }} was not sent for approval.</p><p>Please contact finance.</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "fc764d60-54f7-578e-8f82-d0d1282de54b",
      "name": "Refuse: No Manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        800,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $('Purchase Request Form').item.json;\n// $execution.id is unique and increasing, so IDs never collide and sort in order.\nconst id = 'PR-' + $now.toFormat('yyMMdd') + '-' + $execution.id;\nreturn { json: { request_id: id, requester: f['Your email'].trim().toLowerCase(), manager: $json.manager_email.trim().toLowerCase(), item: f['Item / service'], amount: Number(f['Amount (INR)']),\n  cost_centre: f['Cost centre'], justification: f['Justification'], status: 'pending_manager', created: $now.toISO() } };"
      },
      "id": "b7d62a4f-8541-5ff0-84dc-984cee65efac",
      "name": "Create Request",
