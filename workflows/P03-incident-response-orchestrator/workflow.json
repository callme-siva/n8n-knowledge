{
  "name": "P03 · Incident response orchestrator (alerts → dedupe → Jira + Slack → AI postmortem)",
  "nodes": [
    {
      "parameters": {
        "content": "## 🚨 P03 · From alert storm to one incident\nReceives Alertmanager/Grafana-style webhooks. Groups repeats by **fingerprint** (state kept between runs), opens **one** Jira incident per problem, pages on critical, suppresses repeats, and on *resolved* closes the loop with an **AI postmortem draft**.",
        "width": 580,
        "height": 300,
        "color": 7
      },
      "id": "45cf31b9-b071-564a-b340-6af596a95d88",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alerts",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c72772dd-8e22-50a9-84a9-6c8d1979da3b",
      "name": "POST /alerts",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.alerts",
        "options": {}
      },
      "id": "dfe82341-b9d7-5915-af01-56d99d9446b6",
      "name": "One Item per Alert",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Alertmanager payload: alerts[] { status, fingerprint, labels{alertname,severity,service}, annotations{summary,description}, startsAt, endsAt }\nconst state = $getWorkflowStaticData('global'); state.open ??= {};\nreturn $input.all().map(({ json: a }) => {\n  const fp = a.fingerprint || `${a.labels?.alertname}|${a.labels?.service}`;\n  const known = state.open[fp];\n  const sev = (a.labels?.severity || 'warning').toLowerCase();\n  let action;\n  if (a.status === 'resolved') action = known ? 'resolve' : 'ignore';\n  else if (known) { known.count++; action = 'repeat'; }\n  else { state.open[fp] = { since: a.startsAt || new Date().toISOString(), count: 1, sev }; action = sev === 'critical' ? 'page' : 'notify'; }\n  const rec = state.open[fp] || {};\n  const out = { action, fp, sev, name: a.labels?.alertname, service: a.labels?.service || 'unknown', summary: a.annotations?.summary || '', description: a.annotations?.description || '',\n    since: rec.since, repeats: rec.count, jira_key: rec.jira_key || null, duration_min: a.endsAt && rec.since ? Math.round((Date.parse(a.endsAt) - Date.parse(rec.since)) / 60000) : null };\n  if (action === 'resolve') delete state.open[fp];\n  return { json: out };\n});"
      },
      "id": "570326b6-2cdc-50b4-8a92-73a0ed970c16",
      "name": "Decide Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "page"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Page (critical)"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "notify"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Notify (warning)"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "resolve"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Resolved"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Suppress (repeat)"
        }
      },
      "id": "f6b36294-72e3-55e5-8d50-bad923050e45",
