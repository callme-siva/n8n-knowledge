    {
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 24 * 3600 * 1000;\nconst seen = new Set();\nconst norm = t => String(t || '').toLowerCase().replace(/[^a-z0-9 ]/g, '').slice(0, 60);\nconst articles = $input.all().map(i => i.json)\n  .filter(a => a.title && a.link)\n  .map(a => ({ title: a.title.trim(), link: a.link, source: a.creator || (a.link.match(/https?:\\/\\/(?:www\\.)?([^/]+)/) || [])[1] || 'unknown', ts: Date.parse(a.isoDate || a.pubDate || '') || 0 }))\n  .filter(a => a.ts >= cutoff)\n  .filter(a => { const k = norm(a.title); if (seen.has(k)) return false; seen.add(k); return true; })\n  .sort((a, b) => b.ts - a.ts)\n  .slice(0, 25);\nconst li = articles.map(a => `<li><a href=\"${a.link}\">${a.title}</a> <small>(${a.source})</small></li>`).join('');\nconst listText = articles.map((a, i) => `${i + 1}. ${a.title} — ${a.link}`).join('\\n');\nreturn [{ json: { count: articles.length, html: `<ol>${li}</ol>`, listText } }];"
      },
      "id": "19a24130-440f-5867-b40c-eceb318b60df",
      "name": "Filter · Dedupe · Sort",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Here are today's AI news headlines ({{ $json.count }} items):\n\n{{ $json.listText }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a news editor writing for busy professionals in India. From the headlines, write:\n1. **Top 5 stories**: one bullet each, max 2 sentences: what happened + why it matters. Include the link.\n2. **One-line trend of the day.**\nRules: merge duplicates, skip clickbait, never invent facts beyond the headline. Output clean HTML (<h3>, <ul>, <li>, <a>), no markdown."
            }
          ]
        }
      },
