{
  "name": "Q04 · Stale pull-request reminder (GitHub API → Slack)",
  "nodes": [
    {
      "parameters": {
        "content": "## 🔁 Q04 · Unblock code review\nEvery weekday 10:00, lists open PRs untouched for 2+ days (drafts skipped) and posts one Slack message with owners and reviewers.",
        "width": 460,
        "height": 300,
        "color": 7
      },
      "id": "9ceadb87-b9ce-5769-8bd4-22509e98e2d7",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "id": "ef460b75-90a9-51bb-bbae-f5357127b36b",
      "name": "Weekdays 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "repo",
              "value": "n8n-io/n8n",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "stale_days",
              "value": 2,
              "type": "number"
            },
            {
              "id": "a2",
              "name": "slack_channel",
              "value": "#dev",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "43b97d2d-d539-5614-afa8-d71e01a506be",
      "name": "⚙️ Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "open"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "sort",
              "value": "updated"
            },
            {
              "name": "direction",
              "value": "asc"
            }
          ]
        },
        "options": {}
      },
      "id": "654d8739-0557-58ea-bc14-80b5eaddcf6d",
      "name": "Open PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('⚙️ Config').first().json;\nconst days = d => Math.floor((Date.now() - Date.parse(d)) / 86400000);\nconst prs = $input.all().map(i => i.json).filter(p => p.number && !p.draft && days(p.updated_at) >= cfg.stale_days);\nconst lines = prs.map(p => `• <${p.html_url}|#${p.number} ${p.title}> by *${p.user.login}* · ${days(p.updated_at)}d idle · reviewers: ${(p.requested_reviewers || []).map(r => '@' + r.login).join(', ') || '_none assigned_'}`);\nreturn [{ json: { count: prs.length, text: `:hourglass: *${prs.length} PRs waiting ${cfg.stale_days}+ days in ${cfg.repo}*\\n${lines.join('\\n')}` } }];"
      },
      "id": "fd822a1b-a33a-527d-8ea0-6e0ae9adb161",
      "name": "Find Stale",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.count }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "75c3ba3b-410f-5bb4-83a5-af60fd79c372",
      "name": "Any Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('⚙️ Config').item.json.slack_channel }}"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "8eeccaf2-515b-5bcc-97c2-d8902ffe304c",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1100,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Weekdays 10:00": {
      "main": [
        [
          {
            "node": "⚙️ Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "⚙️ Config": {
      "main": [
        [
          {
            "node": "Open PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open PRs": {
      "main": [
        [
          {
            "node": "Find Stale",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Stale": {
      "main": [
        [
          {
            "node": "Any Stale?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Stale?": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
