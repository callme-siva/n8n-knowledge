      "id": "bd935d39-8b28-56c0-80d4-f52c0fb4644a",
      "name": "Append to Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2640,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inv = $('Validate').item.json;\nconst reason = $json.data && !$json.data.approved ? 'rejected by approver' : inv.errors;\nreturn { json: { logged_at: $now.toISO(), vendor: inv.vendor_name || '', invoice_no: inv.invoice_number || '', total: inv.grand_total || '', file: inv.file, reason } };"
      },
      "id": "3059109c-e64b-5d5c-b984-548e5607c503",
      "name": "Log Exception",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
