{
  "name": "P01 · Accounts-payable invoice pipeline (extract → validate → dedupe → approve → ledger)",
  "nodes": [
    {
      "parameters": {
        "content": "## 🧾 P01 · Accounts payable, automated\nPDF invoices arrive by email → text extracted → **Gemini extracts fields** → **maths & GSTIN validated in code** → duplicates blocked → big invoices need **human approval** → ledger row. Bad ones go to an Exceptions sheet.",
        "width": 560,
        "height": 300,
        "color": 7
      },
      "id": "29ea32f3-7c71-52e8-8fb2-a0325bbd96bc",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 10,
              "unit": "minutes"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "has:attachment filename:pdf label:invoices",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      },
      "id": "eb3b3eb6-04e6-562f-93a7-236a657b8de1",
      "name": "Invoice Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "approval_limit",
              "value": 50000,
              "type": "number"
            },
            {
              "id": "a1",
              "name": "approver_email",
              "value": "you@example.com",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "ap_team_email",
              "value": "you@example.com",
              "type": "string"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true,
        "include": "all"
      },
      "id": "e8a9c6ed-9ee3-5c13-b020-aa31275e1b77",
      "name": "⚙️ Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Ledger"
        },
        "options": {}
      },
      "id": "1219463b-09c8-5b18-ac2e-056b8c62b8a1",
      "name": "Read Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $('Invoice Email').all()) for (const [k, b] of Object.entries(item.binary || {}))\n  if (b.mimeType === 'application/pdf' || (b.fileName || '').toLowerCase().endsWith('.pdf'))\n    out.push({ json: { file: b.fileName, from: item.json.from?.text, messageId: item.json.id }, binary: { data: b }, pairedItem: 0 });\nreturn out;"
      },
      "id": "6d0e80d6-fda3-5cd6-b0ab-f50f722ed20e",
      "name": "One Item per PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "639350b4-4bec-57d6-af62-9ef785d59ba2",
      "name": "PDF → Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "fromAttributes",
        "attributes": {
          "attributes": [
            {
              "name": "vendor_name",
              "type": "string",
              "description": "Seller / supplier legal name",
              "required": true
            },
            {
              "name": "vendor_gstin",
              "type": "string",
              "description": "Seller GSTIN, 15 characters, if present"
            },
            {
              "name": "invoice_number",
              "type": "string",
              "description": "Invoice number exactly as printed",
              "required": true
            },
            {
              "name": "invoice_date",
              "type": "date",
              "description": "Invoice date",
              "required": true
            },
            {
              "name": "due_date",
              "type": "date",
              "description": "Payment due date if present"
            },
            {
              "name": "subtotal",
              "type": "number",
              "description": "Amount before tax"
            },
            {
              "name": "tax_total",
              "type": "number",
              "description": "Total GST/VAT/tax amount"
            },
            {
              "name": "grand_total",
              "type": "number",
              "description": "Final payable amount",
              "required": true
            },
            {
              "name": "currency",
              "type": "string",
              "description": "ISO currency code, e.g. INR"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You extract data from supplier invoices. Only use values printed in the text. If a value is absent, omit it. Never guess numbers."
        }
      },
      "id": "5633a031-7979-5dda-b6e0-f46b5da6b78d",
      "name": "Extract Invoice Fields",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        820,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0
        }
      },
      "id": "cf1ec36b-cfca-54dc-b246-822d6b5f5d65",
      "name": "Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        820,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json.output || {};\nconst src = $('One Item per PDF').item.json;\nconst errors = [];\n// Idempotency: the Ledger sheet is the record of what was already processed.\nconst logged = new Set($('Read Ledger').all().map(i => i.json.dedupe_key).filter(Boolean));\nconst num = v => Number(String(v ?? '').replace(/[^0-9.-]/g, ''));\nconst sub = num(x.subtotal), tax = num(x.tax_total), total = num(x.grand_total);\nif (!x.invoice_number) errors.push('missing invoice number');\nif (!Number.isFinite(total) || total <= 0) errors.push('missing/invalid total');\nif (Number.isFinite(sub) && Number.isFinite(tax) && sub > 0 && Math.abs(sub + tax - total) > 1) errors.push(`subtotal + tax (${sub + tax}) ≠ total (${total})`);\nif (x.vendor_gstin && !/^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/.test(x.vendor_gstin)) errors.push(`GSTIN format invalid: ${x.vendor_gstin}`);\nconst dedupe_key = `${(x.vendor_name || '').toLowerCase().replace(/\\W/g, '')}|${x.invoice_number}`;\nreturn { json: { ...x, subtotal: sub || null, tax_total: tax || null, grand_total: total, file: src.file, from: src.from,\n  dedupe_key, already_logged: logged.has(dedupe_key), valid: errors.length === 0, errors: errors.join('; ') } };"
      },
      "id": "5fac388b-013d-5901-a09a-bd0cd7a40116",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7036dede-c42a-5555-8dd9-1b67321732dd",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "content": "⚠️ **Same invoice twice?** It's skipped here if its `dedupe_key` (vendor + invoice no.) is already in the **Ledger** sheet.\nThe ledger is the memory, so an invoice that failed to append or was rejected is picked up again next time.\nTo re-test: delete its Ledger row.",
        "width": 300,
        "height": 190,
        "color": 4
      },
      "id": "9a20a9fc-f8f0-58ff-92c9-6768a7648217",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1620,
        30
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.already_logged }}",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a963e90b-beed-5365-b759-c90d6fa9a475",
      "name": "New Invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1640,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.grand_total }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": "={{ $('⚙️ Config').item.json.approval_limit }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e6d10f82-e1ac-59b9-9444-7732c52190cb",
      "name": "Needs Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1840,
        -120
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('⚙️ Config').item.json.approver_email }}",
        "subject": "=Approve ₹{{ $json.grand_total }} invoice from {{ $json.vendor_name }}?",
        "message": "=<p><b>{{ $json.vendor_name }}</b> · invoice {{ $json.invoice_number }} · dated {{ $json.invoice_date }}</p><p>Total <b>₹{{ $json.grand_total }}</b> (tax ₹{{ $json.tax_total }}), due {{ $json.due_date }}</p>",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 3,
              "resumeUnit": "days"
            }
          }
        }
      },
      "id": "e6335d39-a68a-5576-89b4-448fa740fb1e",
      "name": "Ask Approver",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2040,
        -220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.approved }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e7b5e964-0bde-58ba-81cc-d4fca3b6422f",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2240,
        -220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inv = $('Validate').item.json;\nreturn { json: { logged_at: $now.toISO(), vendor: inv.vendor_name, gstin: inv.vendor_gstin || '', invoice_no: inv.invoice_number,\n  invoice_date: inv.invoice_date, due_date: inv.due_date || '', subtotal: inv.subtotal, tax: inv.tax_total, total: inv.grand_total,\n  currency: inv.currency || 'INR', approval: $json.data ? 'approved' : 'auto (under limit)', file: inv.file, dedupe_key: inv.dedupe_key } };"
      },
      "id": "a1362c60-d0f2-5442-9485-40c1c5257156",
      "name": "Ledger Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        -120
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
