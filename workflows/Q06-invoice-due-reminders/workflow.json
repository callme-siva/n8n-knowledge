{
  "name": "Q06 · Invoice due & overdue reminders (Sheets as a mini-CRM)",
  "nodes": [
    {
      "parameters": {
        "content": "## 💸 Q06 · Get paid on time\nDaily: finds unpaid invoices due in 3 days (friendly nudge) or overdue (firm reminder), emails the client, and writes `last_reminded` back so nobody gets spammed.",
        "width": 480,
        "height": 300,
        "color": 7
      },
      "id": "6d2229c7-9b74-5fd0-9ca8-3bedd1a1a617",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10
            }
          ]
        }
      },
      "id": "02af5f4f-86a4-50cb-aa16-dfee61fdd450",
      "name": "Daily 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Invoices"
        },
        "options": {}
      },
      "id": "95e91a24-912f-5253-84ce-0f2f4956e00a",
      "name": "Read Invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Columns: invoice_no | client | email | amount | due_date (YYYY-MM-DD) | status (paid/unpaid) | last_reminded\n// $today follows the workflow timezone. new Date() is UTC-based and is off by a day near midnight.\nconst today = $today.toISODate();\nconst daysTo = d => Math.round(DateTime.fromISO(String(d).slice(0, 10), { zone: $today.zoneName }).diff($today, 'days').days);\nreturn $input.all().map(i => i.json)\n  .filter(r => String(r.status).toLowerCase() !== 'paid' && r.due_date && r.last_reminded !== today)\n  .map(r => ({ ...r, days: daysTo(r.due_date) }))\n  .filter(r => r.days === 3 || r.days < 0 && (-r.days) % 7 === 1)   // 3 days before, then weekly once overdue\n  .map(r => ({ json: { ...r, stage: r.days >= 0 ? 'upcoming' : 'overdue' } }));"
      },
      "id": "ab5f2a49-eec5-5d8c-9d25-048aa447251f",
      "name": "Who Needs a Reminder?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "upcoming"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Upcoming"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "overdue"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Overdue"
            }
          ]
        },
        "options": {}
      },
      "id": "c615a655-c543-576b-8455-b1b2e354da0c",
      "name": "Stage",
      "type": "n8n-nodes-base.switch",
